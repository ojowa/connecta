# Local dev server (auto-detected on WiFi)
EXPO_PUBLIC_LOCAL_API_URL=http://YOUR_LAN_IP:3000/v1
EXPO_PUBLIC_LOCAL_WS_URL=http://YOUR_LAN_IP:3000

# Public server (used on mobile data — fill in when deployed)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=

# Sentry error reporting (optional; leave empty to disable).
# The DSN is public by design — it only allows sending events, not reading them.
EXPO_PUBLIC_SENTRY_DSN=
