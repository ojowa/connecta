# Connecta Backend — Environment Variables
# Copy this file to .env and fill in the values

# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=connecta
DB_PASSWORD=password
DB_NAME=connecta_db
DB_SCHEMA=public

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AWS
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=connecta-media

# Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret
PAYSTACK_PUBLIC_KEY=your-paystack-public

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI (AI Features)
OPENAI_API_KEY=your-openai-key

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# CORS
CORS_ORIGIN=http://localhost:3000

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
PROFILE_SERVICE_PORT=3003
MATCHING_SERVICE_PORT=3004
CHAT_SERVICE_PORT=3005
CALL_SERVICE_PORT=3006
MEDIA_SERVICE_PORT=3007
PAYMENT_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009
SEARCH_SERVICE_PORT=3010
ADMIN_SERVICE_PORT=3011
