# Connecta Backend — Environment Variables
# Copy this file to .env and fill in the values

# App
NODE_ENV=development
PORT=3000

# DB Logging
DB_LOGGING=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=connecta_user
DB_PASSWORD=your-db-password
DB_NAME=connecta_db
DB_SCHEMA=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

# AWS
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=connecta-media
CDN_URL=https://cdn.connecta.app

# Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret
PAYSTACK_PUBLIC_KEY=your-paystack-public

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI (AI Features)
OPENAI_API_KEY=your-openai-key

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# CORS
CORS_ORIGIN=*

# App URLs
FRONTEND_URL=http://localhost:8081
ADMIN_PANEL_URL=http://localhost:3012
