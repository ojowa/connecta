# Copy to .env in the app root and fill in real values. Never commit .env.

# --- Database: Neon (recommended) or any external PostgreSQL ---
# From the Neon console: Postgres -> Connection string.
#   - App runtime          : use the POOLED endpoint (host contains "-pooled.")
#   - Migrations / seeding : use the DIRECT endpoint
# Keep ?sslmode=require — Neon requires TLS.
DATABASE_URL=postgresql://user:password@ep-xxx-ag12345.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Required secrets ---
JWT_SECRET=
ADMIN_JWT_SECRET=

# --- Recommended ---
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com

# Optional (cPanel/Passenger sets PORT; dotenv does not override it)
# PORT=3000

# Optional features
# EXPO_PUSH_TOKEN=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
