{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/:path*"
        }
      ]
    }
  ]
}
